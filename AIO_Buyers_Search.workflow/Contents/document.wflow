				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

if [ -z "$1" ]; then
  osascript -e 'display alert "No address received" message "Select a full address first, then use the Services menu."'
  exit 1
fi

ADDRESS="$1"
BEDROOMS="${2:-2-3}"   # used for Trade Me's bedrooms_min/bedrooms_max filter
ZOOM="${3:-19}"        # used for SunCalc's map zoom level

PROJECT_DIR="/Users/akshaynehate/Library/Services/"
PORT=8765
HEARTBEAT="$PROJECT_DIR/.server_heartbeat"
IDLE_TIMEOUT=900   # seconds of inactivity before the local map server shuts itself down

mkdir -p "$PROJECT_DIR"

# ---------- 1. Google Maps transit directions to Britomart ----------
DESTINATION="Britomart, Te Ara Tahuhu, Auckland CBD, Auckland 1140"

DIRECTIONS_URL=$(python3 -c "
import urllib.parse, sys
origin = sys.argv[1]
destination = sys.argv[2]
params = {
    'api': '1',
    'origin': origin,
    'destination': destination,
    'travelmode': 'transit'
}
print('https://www.google.com/maps/dir/?' + urllib.parse.urlencode(params))
" "$ADDRESS" "$DESTINATION")

# ---------- 2. Trade Me sold search ----------
TRADEME_URL=$(python3 -c "
import re, sys, urllib.parse

address = sys.argv[1]
bedrooms = sys.argv[2]

parts = [p.strip() for p in address.split(',') if p.strip()]
street_part = parts[0] if parts else address
suburb_part = parts[1] if len(parts) &gt; 1 else street_part
region_part = parts[-1] if len(parts) &gt; 1 else 'auckland'

def slugify(text):
    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')

# Keep the house number in the slug, e.g. '51 Woodward Road' -&gt; '51-woodward-road'
street_slug = slugify(street_part)
suburb_slug = slugify(suburb_part)
region_slug = slugify(region_part)

base = f'https://www.trademe.co.nz/a/property/insights/search/{region_slug}/{suburb_slug}/{street_slug}'
params = {'sort': 'dateasc'}

nums = re.findall(r'\d+', bedrooms)
if nums:
    params['bedrooms_min'] = nums[0]
    params['bedrooms_max'] = nums[-1]

print(base + '?' + urllib.parse.urlencode(params))
" "$ADDRESS" "$BEDROOMS")

# ---------- 3. Geocode once, shared by LINZ + SunCalc ----------

read X Y &lt; &lt;(python3 -c "
import urllib.request, urllib.parse, json, sys
addr = sys.argv[1]
url = 'https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?' + urllib.parse.urlencode({
    'SingleLine': addr, 'countryCode': 'NZ', 'maxLocations': 1, 'f': 'json'
})
data = json.load(urllib.request.urlopen(url))
loc = data['candidates'][0]['location']
print(loc['x'], loc['y'])
" "$ADDRESS")

# ---------- 4. Offline LINZ viewer: local server + watchdog ----------

LINZ_URL=""
if [ -n "$X" ] &amp;&amp; [ -n "$Y" ]; then
  # Record activity now — resets the idle-shutdown clock
  date +%s &gt; "$HEARTBEAT"

  # Start the local server + watchdog only if not already running
  if ! curl -s "http://localhost:$PORT" &gt; /dev/null 2&gt;&amp;1; then
    (cd "$PROJECT_DIR" &amp;&amp; nohup python3 -m http.server $PORT &gt; /dev/null 2&gt;&amp;1 &amp;)
    sleep 1

    (
      while true; do
        sleep 30
        if [ -f "$HEARTBEAT" ]; then
          LAST=$(cat "$HEARTBEAT")
        else
          LAST=0
        fi
        NOW=$(date +%s)
        if [ $((NOW - LAST)) -ge $IDLE_TIMEOUT ]; then
          PID=$(lsof -ti tcp:$PORT)
          if [ -n "$PID" ]; then
            kill "$PID"
          fi
          rm -f "$HEARTBEAT"
          break
        fi
      done
    ) &amp;
    disown
  fi

  LINZ_URL="http://localhost:$PORT/viewer.html?x=${X}&amp;y=${Y}"
fi

# ---------- 5. SunCalc: current local date/time at the geocoded location ----------

SUNCALC_URL=""
if [ -n "$X" ] &amp;&amp; [ -n "$Y" ]; then
  DATE_STR=$(date +%Y.%m.%d)
  TIME_STR=$(date +%H:%M)
  SUNCALC_URL="https://www.suncalc.org/#/${Y},${X},${ZOOM}/${DATE_STR}/${TIME_STR}/1/1"
fi

# ---------- 6. Open all four as separate tabs in the same Chrome window ----------
open -a "Google Chrome" "$DIRECTIONS_URL"

if [ -n "$LINZ_URL" ]; then
  open -a "Google Chrome" "$LINZ_URL"
else
  osascript -e "display alert \"Geocoding failed\" message \"No LINZ match found for: $ADDRESS.\""
fi

open -a "Google Chrome" "$TRADEME_URL"

if [ -n "$SUNCALC_URL" ]; then
  open -a "Google Chrome" "$SUNCALC_URL"
else
  osascript -e "display alert \"Geocoding failed\" message \"No SunCalc match found for: $ADDRESS.\""
fi</string>
