				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

PROJECT_DIR="/Users/akshaynehate/Library/Services/"
PORT=8765
HEARTBEAT="$PROJECT_DIR/.server_heartbeat"
IDLE_TIMEOUT=900   # seconds of inactivity before shutdown (900 = 15 min, change as you like)

if [ -z "$1" ]; then
  osascript -e 'display alert "No address received" message "Select some address text first, then use the Services menu."'
  exit 1
fi

mkdir -p "$PROJECT_DIR"

# Record that we're active right now — resets the idle clock
date +%s &gt; "$HEARTBEAT"

# Start the local server + watchdog only if the server isn't already running
if ! curl -s "http://localhost:$PORT" &gt; /dev/null 2&gt;&amp;1; then
  (cd "$PROJECT_DIR" &amp;&amp; nohup python3 -m http.server $PORT &gt; /dev/null 2&gt;&amp;1 &amp;)
  sleep 1

  # Background watchdog: checks every 30s, shuts server down after IDLE_TIMEOUT of no new searches
  (
    while true; do
      sleep 30
      if [ -f "$HEARTBEAT" ]; then
        LAST=$(cat "$HEARTBEAT")
      else
        LAST=0
      fi
      NOW=$(date +%s)
      if [ $((NOW - LAST)) -ge $IDLE_TIMEOUT ]; then
        PID=$(lsof -ti tcp:$PORT)
        if [ -n "$PID" ]; then
          kill "$PID"
        fi
        rm -f "$HEARTBEAT"
        break
      fi
    done
  ) &amp;
  disown
fi

# Geocode the address via Esri's World Geocoding Service (NZ only)
read X Y &lt; &lt;(python3 -c "
import urllib.request, urllib.parse, json, sys
addr = sys.argv[1]
url = 'https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?' + urllib.parse.urlencode({
    'SingleLine': addr, 'countryCode': 'NZ', 'maxLocations': 1, 'f': 'json'
})
data = json.load(urllib.request.urlopen(url))
loc = data['candidates'][0]['location']
print(loc['x'], loc['y'])
" "$1")

if [ -z "$X" ] || [ -z "$Y" ]; then
  osascript -e 'display alert "Geocoding failed" message "No match found for that address."'
  exit 1
fi

open -a "Google Chrome" "http://localhost:$PORT/viewer.html?x=${X}&amp;y=${Y}"</string>
					<key>CheckedForUserDefaultShell</key>
